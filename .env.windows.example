# Copiar a ".env" y completar antes de correr deploy-windows.ps1

# IP virtual que Radmin VPN le asigna a esta VM (se ve en la ventana de
# Radmin VPN, red típicamente en el rango 26.x.x.x). Completar después de
# instalar Radmin VPN y unirse/crear la red, antes de levantar el servidor.
RUSTDESK_RELAY_HOST=

# Nivel de log: error | warn | info | debug | trace
RUST_LOG=info
