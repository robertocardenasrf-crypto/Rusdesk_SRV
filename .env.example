# Copiar a ".env" y ajustar antes de levantar docker-compose

# Host/IP que hbbs anuncia a los clientes para el relay (hbbr). En un VPS con IP
# pública, usar esa IP pública. En una VM local para pruebas, la IP LAN de la VM.
RUSTDESK_RELAY_HOST=127.0.0.1

# Nivel de log: error | warn | info | debug | trace
RUST_LOG=info
